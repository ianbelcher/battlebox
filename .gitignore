# Source art packs — see source-art/README.md. The zips are big and what
# actually ships is the models extracted out of them under
# game/assets/models/, so the directory's CONTENTS stay out of git while
# the README that explains it stays in.
source-art/*
!source-art/README.md

# kits/downloads/ is NOT ignored: those files are the source of truth the
# kits are generated from, and they're small. Only the fetcher's scratch
# is ignored.
kits/downloads/*.part
